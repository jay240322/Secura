# Secura Backend Environment Variables
# Copy to .env and configure with your real values.
# NEVER commit .env with real credentials.

# Database URL
DATABASE_URL=sqlite:///./secura.db

# GitHub App Integration
GITHUB_APP_ID=placeholder
APP_KEY_PATH=placeholder
SECURA_WEBHOOK_SECRET=placeholder

# GitHub OAuth App for user login
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder

# Security
JWT_SECRET=placeholder

# Resend Email Configuration
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=Secura <hello@secura.ink>

